      },
      {
        "example": "@pwm2 1500",
        "note": "Channel2 pulse: 500..2500 us.",
        "format": "text"
      },
      {
        "example": "@pwm angle 0 90",
        "note": "Channel 0/1, angle 0..180; check mechanical range.",
        "format": "text"
      },
      {
        "example": "@pwm off",
        "note": "Stop both local PWM outputs.",
        "format": "text"
      }
    ]
