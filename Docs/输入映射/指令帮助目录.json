      },
      {
        "example": "@video status",
        "note": "Read video counters and latest advisory validity.",
        "format": "text"
      },
      {
        "example": "@vision status",
        "note": "Read pixel-only grasp advisory; no actuator execution.",
        "format": "text"
      },
      {
        "example": "@vision clear",
        "note": "Invalidate pixel grasp advisory; does not stop an already commanded actuator.",
        "format": "text"
      }
    ]
  },
  {
    "id": 4,
    "label": "PWM OUTPUT",
    "items": [
      {
        "example": "@pwm 1500",
