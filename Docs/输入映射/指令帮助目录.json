[
  {
    "id": 0,
    "label": "SYSTEM / QUIET",
    "items": [
      {
        "example": "@status",
        "note": "Read current system and motor status.",
        "format": "text"
      },
      {
        "example": "@quiet",
        "note": "Disable periodic text/CSV; this is not a motion stop.",
        "format": "text"
      },
      {
        "example": "@telemetry on",
        "note": "Opt in to P3 probe telemetry.",
        "format": "text"
      },
      {
        "example": "@telemetry off",
        "note": "Stop P3 probe telemetry.",
        "format": "text"
      },
      {
        "example": "@stream on",
        "note": "Opt in to CSV stream.",
        "format": "text"
      },
      {
        "example": "@stream off",
        "note": "Stop CSV stream.",
        "format": "text"
      }
    ]
  },
  {
    "id": 1,
    "label": "CLAW / STS",
    "items": [
      {
        "example": "@claw open",
        "note": "Release/open; requires online and valid limits.",
        "format": "text"
      },
      {
        "example": "@claw close",
        "note": "Grip/close; requires online and valid limits.",
        "format": "text"
      },
      {
        "example": "@claw stop",
        "note": "Request motion stop; not a hardware power cut.",
        "format": "text"
      },
      {
        "example": "@key 5 tap",
        "note": "Physical KEY5 / claw A0 gesture, independent from menu KEY1.",
        "format": "text"
      },
      {
        "example": "@key 6 tap",
        "note": "Physical KEY6 / claw B0 gesture, independent from menu KEY2.",
        "format": "text"
      },
      {
        "example": "@servo probe 0 1000000",
        "note": "Offline read-only probe; ID 0..253, baud 9600..1000000.",
        "format": "text"
      },
      {
        "example": "@servo status",
        "note": "Read configured/probed ID, state, UART receive/reply counts; ID0 is not broadcast.",
        "format": "text"
      },
      {
        "example": "@servo probe 1 1000000",
        "note": "Read-only original servo ID1 / 1Mbps probe.",
        "format": "text"
      },
      {
        "example": "@servo scan 1000000",
        "note": "Read-only unicast ID0..253 scan; stops on first device or exhaustion.",
        "format": "text"
      },
      {
        "example": "@servo angle 90",
        "note": "Equivalent angle control in degrees; online/stack/limits required.",
        "format": "text"
      }
    ]
  },
  {
    "id": 2,
    "label": "MG310 MOTOR",
    "items": [
      {
        "example": "@motor status",
        "note": "Read actual encoder/control state.",
        "format": "text"
      },
      {
        "example": "@motor rpm 100",
        "note": "Target RPM: 0..400 in current configuration.",
        "format": "text"
      },
      {
        "example": "@motor pid 1800 5000 0",
        "note": "Kp Ki Kd in milli-units; each 0..100000, stopped only.",
        "format": "text"
      },
      {
        "example": "@motor enable",
        "note": "Explicit start; missing H-bridge/profile0 rejects.",
        "format": "text"
      },
      {
        "example": "@motor stop",
        "note": "Stop and set target to zero.",
        "format": "text"
      },
      {
        "example": "@motor reverse",
        "note": "Request coast/wait/reverse sequence.",
        "format": "text"
      },
      {
        "example": "@motor clear",
        "note": "Clear fault without restarting.",
        "format": "text"
      },
      {
        "example": "@motor zero",
        "note": "Zero count while stopped.",
        "format": "text"
      },
      {
        "example": "@knob 1",
        "note": "One EC11 detent: +5 RPM, saturates at maximum.",
        "format": "text"
      },
      {
        "example": "@knob -1",
        "note": "One reverse EC11 detent: -5 RPM, saturates at zero.",
        "format": "text"
      },
      {
        "example": "@motor plot on",
        "note": "50Hz JustFloat on HOST; no motor start. USB keeps text replies.",
        "format": "text"
      },
      {
        "example": "@motor plot off",
        "note": "Stop motor wave stream; return HOST to text.",
        "format": "text"
      },
      {
        "example": "@motor plot status",
        "note": "Plot state/counters. While plotting, read response on USB.",
        "format": "text"
      },
      {
        "example": "@motor disable",
        "note": "Disable power output and retain selected RPM for restart.",
        "format": "text"
      },
      {
        "example": "@key 7 tap",
        "note": "KEY7 motor knob button: short release toggles enable; driver0 refuses start.",
        "format": "text"
      },
      {
        "example": "@key 7 press 1200",
        "note": "Motor button: hold >=1000ms reverses once; no enable toggle.",
        "format": "text"
      },
      {
        "example": "@knob 1",
        "note": "Same knob path: +5 RPM, bounded 0..400.",
        "format": "text"
      },
      {
        "example": "@knob -1",
        "note": "Same knob path: -5 RPM, bounded 0..400.",
        "format": "text"
      },
      {
        "example": "@motor rpm 400",
        "note": "Set 400 RPM only; does not start motor.",
        "format": "text"
      }
    ]
  },
  {
    "id": 3,
