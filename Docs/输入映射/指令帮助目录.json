      },
      {
        "example": "@camera mirror",
        "note": "Toggle horizontal mirror.",
        "format": "text"
      },
      {
        "example": "@camera flip",
        "note": "Toggle vertical flip.",
        "format": "text"
      },
      {
        "example": "@camera edge on",
        "note": "Gradient edge preview only.",
        "format": "text"
      },
      {
        "example": "@camera edge off",
        "note": "RGB preview.",
        "format": "text"
      },
      {
        "example": "@lcd rotate",
        "note": "LCD text orientation +90 independently.",
        "format": "text"
      },
      {
        "example": "@camera retry",
        "note": "Reinitialize sensor while motion stopped.",
        "format": "text"
      },
      {
        "example": "@camera clock 4",
        "note": "OV5640 divider: 0,1,2,4,8,16; stopped only.",
        "format": "text"
      },
      {
        "example": "@lcd test",
        "note": "LCD test pattern; next menu gesture restores menu.",
