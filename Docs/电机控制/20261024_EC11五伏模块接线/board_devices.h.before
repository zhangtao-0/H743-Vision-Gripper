#ifndef BOARD_DEVICES_H
#define BOARD_DEVICES_H
/* Device-level wiring of LXB743ZI-P1. Keep vendor originals unchanged. */
#define BOARD_LCD_INSTANCE SPI6
#define BOARD_LCD_SPI_PORT GPIOG
#define BOARD_LCD_SPI_PINS (GPIO_PIN_8|GPIO_PIN_13|GPIO_PIN_14)
#define BOARD_LCD_SPI_AF GPIO_AF5_SPI6
#define BOARD_LCD_PRESCALER SPI_BAUDRATEPRESCALER_4
#define BOARD_LCD_BL_PORT GPIOG
#define BOARD_LCD_BL_PIN GPIO_PIN_12
#define BOARD_LCD_DC_PORT GPIOG
#define BOARD_LCD_DC_PIN GPIO_PIN_15
#define BOARD_CAM_E_PORT GPIOE
#define BOARD_CAM_E_PINS (GPIO_PIN_4|GPIO_PIN_5|GPIO_PIN_6)
#define BOARD_CAM_D_PORT GPIOD
#define BOARD_CAM_D_PINS GPIO_PIN_3
#define BOARD_CAM_G_PORT GPIOG
#define BOARD_CAM_G_PINS (GPIO_PIN_9|GPIO_PIN_10|GPIO_PIN_11)
#define BOARD_CAM_C_PORT GPIOC
#define BOARD_CAM_C_PINS (GPIO_PIN_6|GPIO_PIN_7)
#define BOARD_CAM_A_PORT GPIOA
#define BOARD_CAM_A_PINS (GPIO_PIN_4|GPIO_PIN_6)
#define BOARD_CAM_AF GPIO_AF13_DCMI
#define BOARD_CAM_PWDN_PORT GPIOF
#define BOARD_CAM_PWDN_PIN GPIO_PIN_13
#define BOARD_CAM_SCL_PORT GPIOF
#define BOARD_CAM_SCL_PIN GPIO_PIN_14
#define BOARD_CAM_SDA_PORT GPIOF
#define BOARD_CAM_SDA_PIN GPIO_PIN_15
#define BOARD_SD_DATA_PORT GPIOC
#define BOARD_SD_DATA_PINS (GPIO_PIN_8|GPIO_PIN_9|GPIO_PIN_10|GPIO_PIN_11|GPIO_PIN_12)
#define BOARD_SD_CMD_PORT GPIOD
#define BOARD_SD_CMD_PIN GPIO_PIN_2
#define BOARD_SD_AF GPIO_AF12_SDIO1
#define BOARD_SD_CLKDIV 2U
#define BOARD_QSPI_INSTANCE QUADSPI
#define BOARD_QSPI_PRESCALER 3U
#define BOARD_QSPI_CLK_PORT GPIOF
#define BOARD_QSPI_CLK_PIN GPIO_PIN_10
#define BOARD_QSPI_CLK_AF GPIO_AF9_QUADSPI
#define BOARD_QSPI_CS_PORT GPIOG
#define BOARD_QSPI_CS_PIN GPIO_PIN_6
#define BOARD_QSPI_CS_AF GPIO_AF10_QUADSPI
#define BOARD_QSPI_IO0_PORT GPIOF
#define BOARD_QSPI_IO0_PIN GPIO_PIN_8
#define BOARD_QSPI_IO1_PORT GPIOF
#define BOARD_QSPI_IO1_PIN GPIO_PIN_9
#define BOARD_QSPI_IO2_PORT GPIOF
#define BOARD_QSPI_IO2_PIN GPIO_PIN_7
#define BOARD_QSPI_IO3_PORT GPIOF
#define BOARD_QSPI_IO3_PIN GPIO_PIN_6
#define BOARD_QSPI_IO_AF GPIO_AF10_QUADSPI
#define BOARD_PWM_PORT GPIOD
#define BOARD_PWM_PIN GPIO_PIN_12
#define BOARD_PWM2_PIN GPIO_PIN_13
#define BOARD_PWM_AF GPIO_AF2_TIM4
#define BOARD_PWM_KERNEL_HZ 200000000UL
/* MG310 extension: TIM1 encoder, TIM12 PWM, TIM6 1ms control scheduler. */
#define BOARD_MOTOR_HALL_TIM TIM1
#define BOARD_MOTOR_PWM_TIM TIM12
#define BOARD_MOTOR_TICK_TIM TIM6
#define BOARD_MOTOR_TICK_IRQn TIM6_DAC_IRQn
#define BOARD_MOTOR_HALL_CLOCK_ENABLE() __HAL_RCC_TIM1_CLK_ENABLE()
#define BOARD_MOTOR_PWM_CLOCK_ENABLE() __HAL_RCC_TIM12_CLK_ENABLE()
#define BOARD_MOTOR_TICK_CLOCK_ENABLE() __HAL_RCC_TIM6_CLK_ENABLE()
/* Independent channel ports: PE9 remains suspect after pull-up isolation. */
#define BOARD_MOTOR_HALL_A_PORT GPIOA
#define BOARD_MOTOR_HALL_A_PIN GPIO_PIN_8
#define BOARD_MOTOR_HALL_A_AF GPIO_AF1_TIM1
#define BOARD_MOTOR_HALL_B_PORT GPIOE
#define BOARD_MOTOR_HALL_B_PIN GPIO_PIN_11
#define BOARD_MOTOR_HALL_B_AF GPIO_AF1_TIM1
/* PA8/PE11 FT digital inputs; encoder internal pull-ups follow5V supply. */
#define BOARD_MOTOR_HALL_PULL GPIO_NOPULL
#define BOARD_MOTOR_PWM_PORT GPIOB
#define BOARD_MOTOR_PWM_PIN GPIO_PIN_14
#define BOARD_MOTOR_PWM2_PIN GPIO_PIN_15
#define BOARD_MOTOR_PWM_AF GPIO_AF2_TIM12
#define BOARD_MOTOR_DIR_PORT GPIOE
#define BOARD_MOTOR_IN1 GPIO_PIN_10
#define BOARD_MOTOR_IN2 GPIO_PIN_12
#define BOARD_MOTOR_STBY GPIO_PIN_13
#define BOARD_MOTOR_KNOB_PORT GPIOG
#define BOARD_MOTOR_KNOB_A GPIO_PIN_2
#define BOARD_MOTOR_KNOB_B GPIO_PIN_3
#define BOARD_MOTOR_KEY_PORT GPIOC
#define BOARD_MOTOR_KEY_PIN GPIO_PIN_13
/* PC4/PA5 remain camera-only; PG4/PG5 remain reserved for expansion. */
#endif
