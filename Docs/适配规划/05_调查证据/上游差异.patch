-        return 0U;
-    }
-
-    if (desc->width == 1U) {
-        *value = data[0];
-        return 1U;
-    }
-    if (desc->width != 2U) {
-        return 0U;
-    }
-
-    raw = (uint16_t)data[0] | ((uint16_t)data[1] << 8);
-    if (desc->value_type == FEETECH_STS_REG_VALUE_S16) {
-        *value = (int16_t)raw;
-    } else {
-        *value = raw;
-    }
-    return 1U;
-}
