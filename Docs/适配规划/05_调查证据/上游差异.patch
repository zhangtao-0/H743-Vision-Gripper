-            *failed_desc = desc;
-        }
-        if ((offset + desc->width) > data_len) {
-            return FEETECH_STS_REG_CHECK_PARTIAL;
-        }
-        if (desc->access != FEETECH_STS_REG_ACCESS_RW) {
-            return FEETECH_STS_REG_CHECK_READ_ONLY;
-        }
-        if (desc->write_enable == 0U) {
