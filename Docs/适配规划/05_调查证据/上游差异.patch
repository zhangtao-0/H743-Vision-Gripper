-// 同步设置 PA6/PB1 两路 PWM 高电平宽度。
-void TIM3_SERVO_PWM_SetPulseUs(uint16_t pulse_us)
+// 启动指定 PWM 舵机通道。
+HAL_StatusTypeDef TIM3_SERVO_PWM_StartChannel(Tim3ServoPwmChannel_t channel)
+{
+  switch (channel) {
+    case TIM3_SERVO_PWM_CHANNEL_1:
+#if TIM3_CH1_PWM_PIN_ENABLE
+      return HAL_TIM_PWM_Start(&htim3, TIM_CHANNEL_1);
+#else
+      return HAL_ERROR;
+#endif
+
+    case TIM3_SERVO_PWM_CHANNEL_2:
+#if TIM3_CH4_PWM_PIN_ENABLE
+      return HAL_TIM_PWM_Start(&htim3, TIM_CHANNEL_4);
+#else
+      return HAL_ERROR;
+#endif
+
+    default:
+      return HAL_ERROR;
+  }
+}
+
+// 设置指定 PWM 舵机通道的高电平宽度。
+HAL_StatusTypeDef TIM3_SERVO_PWM_SetPulseUs(Tim3ServoPwmChannel_t channel, uint16_t pulse_us)
 {
   if (pulse_us >= TIM3_SERVO_PWM_PERIOD_US) {
     pulse_us = TIM3_SERVO_PWM_PERIOD_US - 1U;
   }
-#if TIM3_CH1_PWM_PIN_ENABLE
-  __HAL_TIM_SET_COMPARE(&htim3, TIM_CHANNEL_1, pulse_us);
-#endif
-#if TIM3_CH4_PWM_PIN_ENABLE
-  __HAL_TIM_SET_COMPARE(&htim3, TIM_CHANNEL_4, pulse_us);
-#endif
+
+  switch (channel) {
+    case TIM3_SERVO_PWM_CHANNEL_1:
+#if TIM3_CH1_PWM_PIN_ENABLE
+      __HAL_TIM_SET_COMPARE(&htim3, TIM_CHANNEL_1, pulse_us);
+      return HAL_OK;
+#else
+      return HAL_ERROR;
+#endif
+
+    case TIM3_SERVO_PWM_CHANNEL_2:
+#if TIM3_CH4_PWM_PIN_ENABLE
+      __HAL_TIM_SET_COMPARE(&htim3, TIM_CHANNEL_4, pulse_us);
+      return HAL_OK;
+#else
+      return HAL_ERROR;
+#endif
+
+    default:
+      return HAL_ERROR;
+  }
 }
 
