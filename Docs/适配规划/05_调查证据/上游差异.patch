+// 定宽显示文本并覆盖旧字符。
+static void Screen_ShowFixedText(uint8_t line, uint8_t column, const char *text, uint8_t width)
+{
+    uint8_t i;
+    char buf[8];
+
+    if (width >= sizeof(buf)) {
+        width = (uint8_t)(sizeof(buf) - 1U);
+    }
+    for (i = 0U; i < width; i++) {
+        buf[i] = ((text != 0) && (text[i] != '\0')) ? text[i] : ' ';
+    }
+    buf[width] = '\0';
+    OLED_ShowString(line, column, buf);
+}
