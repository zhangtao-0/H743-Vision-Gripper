-// 按小端格式解码寄存器值。
-uint8_t FeetechStsRegister_DecodeValue(const FeetechStsRegisterDesc_t *desc,
-                                       const uint8_t *data,
-                                       uint8_t data_len,
-                                       int32_t *value)
-{
-    uint16_t raw;
